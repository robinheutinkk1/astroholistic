# ---------------------------------------------------------------------------
# TagPoint Taxi Dispatch — voorbeeldconfiguratie
#
# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.
# Commit NOOIT echte secrets (§51).
# ---------------------------------------------------------------------------

# --- Supabase: publiek (mag in de browserbundle) ---------------------------
# De anon key is publiek by design. Hij is alleen veilig omdat RLS aanstaat;
# dat is de kernaanname van dit platform. Zie docs/SECURITY.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase: server-only -------------------------------------------------
# Omzeilt RLS volledig. Uitsluitend in lib/supabase/admin.ts, achter
# `import 'server-only'`. Nooit met NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Applicatie ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_HOST=app.tagpoint.nl

# --- Beveiliging -----------------------------------------------------------
# Pepper voor het hashen van NFC/QR-tokens. Bewust buiten de database, zodat
# een databasedump zonder deze waarde niet te bruteforcen is.
# Genereer met: openssl rand -base64 48
TAG_TOKEN_PEPPER=

# Beschermt de ritgeneratie-cronroute tegen aanroepen van buitenaf.
# Genereer met: openssl rand -base64 32
CRON_SECRET=
